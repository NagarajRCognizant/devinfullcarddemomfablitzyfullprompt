# Template for the local docker-compose stack: copy to .env and replace every value.
#
#   cp .env.example .env
#
# .env is git-ignored and must stay that way. None of the values below are defaults the stack falls
# back to: docker-compose.yml declares them ${VAR:?}, so an unset one stops the stack with a message
# instead of quietly starting with a well-known secret. Generate them, do not reuse these examples,
# and never commit a filled-in file.
#
#   openssl rand -hex 24                      # a password or a client secret
#   python3 -c 'import base64,os; print(base64.b32encode(os.urandom(20)).decode())'   # a TOTP secret

# Optional and not a secret: a mirror of Maven Central for the service image builds, for a network
# that cannot reach or is rate-limited by repo.maven.apache.org. Leave unset to build against Central.
#MAVEN_MIRROR_URL=https://maven-central.storage-download.googleapis.com/maven2/

# The three business databases (account, identity, authorization).
CARDDEMO_DB_USER=carddemo
CARDDEMO_DB_PASSWORD=replace-me

# Keycloak's own database.
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=replace-me

# The realm administrator of the local Keycloak, used by the bootstrap step and by the admin console
# on http://127.0.0.1:8088. Not a CardDemo user: it administers the realm, it does not sign on to the
# application.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-me

# The three confidential clients. carddemo-identity-admin lets the identity service provision realm
# users; carddemo-authorization-svc lets the Kafka-driven authorization flow get its own token with
# client_credentials; carddemo-transaction-svc lets the bill payment adjust the account balance in
# the account service. The SPA (carddemo-ui) is a public client and deliberately has no secret.
KEYCLOAK_IDENTITY_CLIENT_SECRET=replace-me
KEYCLOAK_AUTHORIZATION_CLIENT_SECRET=replace-me
KEYCLOAK_TRANSACTION_CLIENT_SECRET=replace-me

# The users the E2E suite drives: admin001 (an ADMIN), user0001 (a USER), user0002, the one the refusal
# tests key wrong codes for so that the realm's lockout does not fall on a user another test still has
# to sign on as, and user0003, which has a password and no authenticator so that the enrolment test can
# go through CONFIGURE_TOTP. The first three are the only users whose TOTP secret is known, which is
# what lets a test compute a valid code. The secrets are base32, as an authenticator app expects.
E2E_PASSWORD=replace-me
E2E_ADMIN_TOTP_SECRET=REPLACEMEWITHABASE32SECRET
E2E_USER_TOTP_SECRET=REPLACEMEWITHABASE32SECRET
E2E_LOCKOUT_TOTP_SECRET=REPLACEMEWITHABASE32SECRET
