<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.carddemo</groupId>
    <artifactId>carddemo-modernization</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>carddemo-account-domain</artifactId>
  <name>CardDemo Account Domain</name>
  <description>The ACCTDAT, CUSTDAT and CARDXREF record layouts as JPA entities with their
    repositories, shared by the account service and the account extract batch job</description>

  <dependencies>
    <dependency>
      <groupId>com.carddemo</groupId>
      <artifactId>carddemo-common</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <!-- The shared integration test base class re-applies the migrations of the service under
         test; both consumers put Flyway on the runtime classpath themselves. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <id>test-jar</id>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <configuration>
          <!-- Entities and repository interfaces are declarative mappings; the business logic they
               carry is covered by the account service and batch modules. -->
          <skip>true</skip>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
