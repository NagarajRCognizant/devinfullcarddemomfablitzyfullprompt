<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.4</version>
    <relativePath/>
  </parent>

  <groupId>com.carddemo</groupId>
  <artifactId>carddemo-modernization</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>CardDemo Modernization</name>
  <description>Java microservices conversion of the CardDemo COBOL/CICS/VSAM account management,
    user administration and credit card authorization capabilities</description>

  <modules>
    <module>common</module>
    <module>security</module>
    <module>account-domain</module>
    <module>account-service</module>
    <module>identity-service</module>
    <module>batch-account-extract</module>
    <module>authorization-domain</module>
    <module>authorization-service</module>
    <module>batch-auth-purge</module>
    <module>transaction-domain</module>
    <module>transaction-client</module>
    <module>transaction-service</module>
    <module>batch-transaction</module>
    <module>gateway</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <jacoco.version>0.8.12</jacoco.version>
    <springdoc.version>2.6.0</springdoc.version>
    <spring-cloud.version>2023.0.3</spring-cloud.version>
    <coverage.line.minimum>0.80</coverage.line.minimum>
    <coverage.branch.minimum>0.80</coverage.branch.minimum>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.carddemo</groupId>
        <artifactId>carddemo-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.carddemo</groupId>
        <artifactId>carddemo-security</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.carddemo</groupId>
        <artifactId>carddemo-account-domain</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.carddemo</groupId>
        <artifactId>carddemo-account-domain</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>com.carddemo</groupId>
        <artifactId>carddemo-authorization-domain</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.carddemo</groupId>
        <artifactId>carddemo-authorization-domain</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>com.carddemo</groupId>
        <artifactId>carddemo-transaction-domain</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.carddemo</groupId>
        <artifactId>carddemo-transaction-domain</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>com.carddemo</groupId>
        <artifactId>carddemo-transaction-client</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <configuration>
          <!-- Coverage applies to migrated business logic. Framework wiring, DTOs, entities and
               the security plumbing are excluded. -->
          <excludes>
            <exclude>com/carddemo/**/*Application.class</exclude>
            <exclude>com/carddemo/**/config/**</exclude>
            <exclude>com/carddemo/**/api/dto/**</exclude>
            <exclude>com/carddemo/config/**</exclude>
            <exclude>com/carddemo/api/dto/**</exclude>
            <exclude>com/carddemo/persistence/entity/**</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>check-business-logic-coverage</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <haltOnFailure>true</haltOnFailure>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${coverage.line.minimum}</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${coverage.branch.minimum}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
